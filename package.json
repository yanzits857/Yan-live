const http = require('http');
const fs = require('fs');
const path = require('path');
const { WebSocketServer } = require('ws');
const { WebcastPushConnection } = require('tiktok-live-connector');

const server = http.createServer((req, res) => {
  try {
    const f = req.url.startsWith('/fila') ? 'fila.html' : req.url.startsWith('/jogos') ? 'jogos.html' : 'index.html';
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
    res.end(fs.readFileSync(path.join(__dirname, f)));
  } catch (e) {
    res.writeHead(404);
    res.end('Nao encontrado');
  }
});

const wss = new WebSocketServer({ server });

wss.on('connection', (ws, req) => {
  const user = new URL(req.url, 'http://x').searchParams.get('user');
  const send = (event, data) => ws.readyState === 1 && ws.send(JSON.stringify({ event, data }));
  if (!user) return send('status', { text: 'Informe o @ do TikTok' });

  const tt = new WebcastPushConnection(user.replace('@', ''));
  tt.connect()
    .then(() => send('status', { text: 'Conectado na live de @' + user.replace('@', '') }))
    .catch(e => send('status', { text: 'Erro: ' + (e.message || e) + ' (a live esta ao vivo?)' }));

  tt.on('chat', d => send('chat', { uniqueId: d.uniqueId, nickname: d.nickname, comment: d.comment }));
  tt.on('like', d => send('like', { uniqueId: d.uniqueId, nickname: d.nickname, likeCount: d.likeCount }));
  tt.on('follow', d => send('follow', { uniqueId: d.uniqueId, nickname: d.nickname }));
  tt.on('gift', d => {
    if (d.giftType === 1 && !d.repeatEnd) return;
    send('gift', { uniqueId: d.uniqueId, nickname: d.nickname, giftName: d.giftName, repeatCount: d.repeatCount, diamondCount: d.diamondCount });
  });
  tt.on('disconnected', () => send('status', { text: 'Live desconectada' }));

  ws.on('close', () => { try { tt.disconnect(); } catch (e) {} });
});

server.listen(process.env.PORT || 3000, () => console.log('Rodando'));
